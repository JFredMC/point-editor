{
  "name": "point-editor",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --base-href /point-editor/ && node scripts/postbuild-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "serve:pages": "node scripts/serve-pages.mjs",
    "e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "bootstrap-icons": "^1.13.1",
    "maplibre-gl": "^5.24.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "bootstrap": "^5.3.8",
    "sweetalert2": "^11.23.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
